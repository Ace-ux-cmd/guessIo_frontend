# Copy to .env for local development. Vite bakes VITE_* values into the bundle
# at build time, so set the real production values in the build environment
# (or a .env.production that is not committed), never a dev tunnel URL.
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
# Google Form for the Support page feedback card; the card shows "Survey closed" when unset.
VITE_SUPPORT_GOOGLE_FORM_URL=

